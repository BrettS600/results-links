{
  "manifest_version": 3,
  "name": "Cert Reader (PSA + CGC)",
  "version": "1.1.0",
  "description": "When you open a PSA or CGC cert page yourself, reads what the page shows, saves it to Downloads/cert-reader/results.csv and sends it to your card-inbox on GitHub. Makes no requests to PSA or CGC.",
  "permissions": ["storage", "unlimitedStorage", "downloads", "offscreen", "alarms"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["https://*.psacard.com/cert/*", "https://psacard.com/cert/*",
                  "https://*.cgccards.com/certlookup/*", "https://cgccards.com/certlookup/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {"default_title": "Cert Reader", "default_popup": "popup.html"}
}
